{
  "name": "cajitas-ahorro",
  "version": "0.22.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --config playwright.public.config.js",
    "build:native": "vite build --mode native",
    "build:android": "node scripts/android-build.mjs",
    "sync:ios": "npm run build:native && cap sync ios",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "build:pages": "vite build --mode pages",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "preview:pages": "vite preview --mode pages --host 0.0.0.0",
    "check:setup": "node scripts/check-setup.mjs",
    "verify": "npm test && npm run build:pages && npm run test:e2e && npm run test:e2e:public",
    "test:rules": "firebase --project demo-guardadito emulators:exec --only firestore \"vitest run --config vitest.rules.config.js\"",
    "test:e2e:cloud": "firebase --project demo-guardadito emulators:exec --only auth,firestore \"playwright test --config playwright.cloud.config.js\"",
    "emulators": "firebase --project demo-guardadito emulators:start --only auth,firestore",
    "deploy:rules": "firebase deploy --only firestore:rules --project guardadito-94c49"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/nunito": "^5.3.0",
    "firebase": "^13.0.0",
    "google-auth-library": "^10.3.0",
    "jose": "^6.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^14.27.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
