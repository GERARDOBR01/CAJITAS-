rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function pair(pairId) {
      return get(/databases/$(database)/documents/pairs/$(pairId)).data;
    }
    function member(pairId) {
      return signedIn() && request.auth.uid in pair(pairId).members;
    }
    function shortText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    // The whole journal of one person, as the same JSON a backup has.
    match /users/{uid}/state/main {
      allow read, delete: if owner(uid);
      allow write: if owner(uid)
        && request.resource.data.keys().hasOnly(["raw", "savedAt", "version", "updatedAt"])
        && request.resource.data.raw is string
        && request.resource.data.raw.size() < 1000000
        && request.resource.data.savedAt is number;
    }

    // A code one person shares with their partner. Anyone who knows the
    // code can read it (it cannot be listed); it lasts at most 48 hours.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.size() == 6
        && request.resource.data.keys().hasOnly(["from", "fromName", "expiresAt"])
        && request.resource.data.from == request.auth.uid
        && shortText(request.resource.data.fromName, 40)
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt <= request.time.toMillis() + 172800000;
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // Two people. The id is both uids sorted and joined with "_", so a
    // couple has exactly one. Created by the person who received a valid
    // invite from the other one.
    match /pairs/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["members", "names", "invite"])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && pairId == request.resource.data.members[0] + "_" + request.resource.data.members[1]
        && request.resource.data.members[0] < request.resource.data.members[1]
        && request.resource.data.invite is string
        && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.from
          in request.resource.data.members
        && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.from
          != request.auth.uid
        && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.expiresAt
          > request.time.toMillis();
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["names"])
        && request.resource.data.names.diff(resource.data.names).affectedKeys()
          .hasOnly([request.auth.uid]);
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      // How each one's cajitas are going, shared with the partner.
      match /summaries/{uid} {
        allow read: if member(pairId);
        allow write: if owner(uid) && member(pairId)
          && request.resource.data.keys().hasOnly(["goals", "updatedAt"])
          && request.resource.data.goals is list
          && request.resource.data.goals.size() <= 200;
        allow delete: if owner(uid);
      }

      // Cajitas both of them save for. No admins: either one edits it; it is
      // archived, never deleted, so nobody erases the other's savings.
      match /goals/{goalId} {
        allow read: if member(pairId);
        allow create, update: if member(pairId)
          && request.resource.data.keys().hasOnly(["name", "targetCents", "unlockDate",
            "icon", "split", "createdBy", "createdAt", "archived"])
          && shortText(request.resource.data.name, 80)
          && request.resource.data.targetCents is int
          && request.resource.data.targetCents > 0
          && request.resource.data.targetCents <= 100000000000
          && request.resource.data.split is map
          && request.resource.data.split.keys().hasOnly(pair(pairId).members)
          && request.resource.data.archived is bool;
        allow delete: if false;
      }
      // What each one set aside (positive) or took out (negative) in their
      // own bank. Each person records and corrects only their own.
      match /entries/{entryId} {
        allow read: if member(pairId);
        allow create: if member(pairId)
          && request.resource.data.keys().hasOnly(["goalId", "by", "cents", "at", "note", "createdAt"])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.cents is int
          && request.resource.data.cents != 0
          && request.resource.data.cents <= 100000000000
          && request.resource.data.cents >= -100000000000
          && request.resource.data.at is string
          && (!("note" in request.resource.data) || request.resource.data.note.size() <= 200)
          && exists(/databases/$(database)/documents/pairs/$(pairId)/goals/$(request.resource.data.goalId));
        allow update: if member(pairId)
          && resource.data.by == request.auth.uid
          && request.resource.data.by == resource.data.by
          && request.resource.data.goalId == resource.data.goalId
          && request.resource.data.cents is int
          && request.resource.data.cents != 0;
        allow delete: if member(pairId) && resource.data.by == request.auth.uid;
      }

      // Where to send money when one keeps the savings of the other (the
      // guardian): only the couple sees it.
      match /payout/{uid} {
        allow read: if member(pairId);
        allow write: if owner(uid) && member(pairId)
          && request.resource.data.keys().hasOnly(["clabe", "holder", "bank", "updatedAt"])
          && request.resource.data.clabe is string
          && request.resource.data.clabe.matches("^[0-9]{18}$")
          && shortText(request.resource.data.holder, 60)
          && shortText(request.resource.data.bank, 40);
        allow delete: if owner(uid);
      }
      // Money handed to the guardian (positive) or asked back (negative).
      // It only counts once the guardian says it arrived; then the sender's
      // app records it and marks it as applied.
      match /deposits/{depositId} {
        allow read: if member(pairId);
        allow create: if member(pairId)
          && request.resource.data.keys().hasOnly(["from", "to", "goalId", "goalName",
            "cents", "method", "status", "note", "createdAt"])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to in pair(pairId).members
          && request.resource.data.to != request.auth.uid
          && exists(/databases/$(database)/documents/pairs/$(pairId)/payout/$(request.resource.data.to))
          && shortText(request.resource.data.goalId, 80)
          && shortText(request.resource.data.goalName, 80)
          && request.resource.data.cents is int
          && request.resource.data.cents != 0
          && request.resource.data.cents <= 100000000000
          && request.resource.data.cents >= -100000000000
          && request.resource.data.method in ["spei", "cash"]
          && request.resource.data.status == "pending"
          && (!("note" in request.resource.data) || request.resource.data.note.size() <= 200);
        allow update: if member(pairId) && (
          (resource.data.to == request.auth.uid
            && resource.data.status == "pending"
            && request.resource.data.status in ["confirmed", "rejected"]
            && request.resource.data.decidedAt is int
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "decidedAt"]))
          || (resource.data.from == request.auth.uid
            && resource.data.status == "confirmed"
            && request.resource.data.appliedAt is int
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["appliedAt"])));
        // The sender cancels or clears it; a confirmed one only once applied.
        allow delete: if member(pairId) && resource.data.from == request.auth.uid
          && (resource.data.status != "confirmed" || "appliedAt" in resource.data);
      }

      // Surprises from one to the other: a special pet, notes, rewards.
      match /gifts/{giftId} {
        allow read: if member(pairId);
        allow create: if member(pairId)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to in pair(pairId).members
          && request.resource.data.to != request.auth.uid
          && request.resource.data.kind in ["pet", "note", "reward"]
          && !("openedAt" in request.resource.data)
          && request.resource.data.keys().hasOnly(["from", "to", "kind", "fromName",
            "lines", "loveText", "motto", "text", "showOn", "date",
            "goalId", "goalName", "threshold", "title", "image", "createdAt"])
          && (!("text" in request.resource.data) || shortText(request.resource.data.text, 600))
          && (!("image" in request.resource.data)
            || (request.resource.data.image is string && request.resource.data.image.size() < 400000));
        // The sender edits; the receiver can only mark it as opened.
        allow update: if member(pairId) && (
          (resource.data.from == request.auth.uid
            && request.resource.data.from == resource.data.from
            && request.resource.data.to == resource.data.to
            && request.resource.data.kind == resource.data.kind
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lines", "loveText",
              "motto", "text", "showOn", "date", "goalId", "goalName", "threshold", "title",
              "image", "createdAt", "openedAt", "fromName"]))
          || (resource.data.to == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["openedAt"])));
        allow delete: if member(pairId) && resource.data.from == request.auth.uid;
      }
    }
  }
}
