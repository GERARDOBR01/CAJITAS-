# Server only. Never use a VITE_ prefix for secrets.
APP_ORIGIN=http://localhost:5173
# Exact public frontend URL, including /CAJITAS-/ for GitHub Pages.
# Leave empty for same-origin development. Server-side allowlist, not a secret.
WEB_APP_URL=
BANXICO_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/gmail/callback
# Exact senders from your real receipts; comma-separated. No guessed defaults.
GMAIL_NU_SENDERS=
GMAIL_MP_SENDERS=
# Generate a random 32+ character value for encrypting server session records.
SESSION_SECRET=
# Required in production for server-side sessions (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional personal Bitso integration, protected by owner login.
BITSO_API_KEY=
BITSO_API_SECRET=
BITSO_OWNER_PASSWORD=
# Pages/native: public HTTPS backend ORIGIN (no /api path), never a secret.
# Configure before build:pages/build:native and rebuild when it changes.
VITE_API_ORIGIN=
# Explicit native origins allowed by server (leave empty to disable native APIs).
NATIVE_APP_ORIGINS=capacitor://localhost,https://localhost
# Optional public link to the Android preview APK release.
VITE_ANDROID_DOWNLOAD_URL=
# Avisos (Web Push, v0.13). Server only: generate with `npx web-push generate-vapid-keys`.
# The public key must match vapidPublicKey in src/cloud/config.js.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Pages/native: public HTTPS origin of the backend that serves /api/push.
VITE_PUSH_ORIGIN=
